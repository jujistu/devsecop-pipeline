# Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored and is what the API + arq worker load at runtime.

# development | production (production deletes outputs/<job_id> after indexing)
APP_ENV=development

MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DB?retryWrites=true&w=majority

R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nuggets-dev
R2_REGION=auto

# Local Redis for the arq worker (default matches if unset)
REDIS_URL=redis://localhost:6379
