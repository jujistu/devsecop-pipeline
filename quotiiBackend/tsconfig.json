{
  "compilerOptions": {
    "target": "ES2018",
    "allowJs": true,
    "checkJs": false,
    "module": "CommonJS",
    "lib": ["esnext"],
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/**/__tests__/**", "src/**/*.test.ts"]
}
