{
  "name": "quotiibackend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/run-tests.sh",
    "test:coverage": "c8 --reporter=lcov --reporter=text --include='src/**/*.ts' --exclude='**/__tests__/**' --exclude='**/*.test.ts' bash scripts/run-tests.sh",
    "test:cloud-index": "node --import ts-node/register --test src/__tests__/cloudIndex.status.test.ts",
    "test:book-index": "node --import ts-node/register --test src/__tests__/bookIndex.test.ts",
    "test:http": "npx ts-node src/__tests__/http.api.test.ts",
    "test:explain": "node --import ts-node/register --test src/__tests__/explain.sse.test.ts",
    "test:ask": "node --import ts-node/register --test src/__tests__/ask.sse.test.ts",
    "test:summary": "node --import ts-node/register --test src/__tests__/summary.sse.test.ts",
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "clean": "rm -rf node_modules dist coverage && yarn cache clean && yarn install",
    "local": "yarn clean && yarn dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@apollo/server": "^4.10.4",
    "@aws-sdk/client-s3": "^3.637.0",
    "@graphql-tools/schema": "^10.0.4",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.6",
    "axios": "^1.7.2",
    "body-parser": "^1.20.2",
    "bullmq": "^5.10.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.11.0",
    "express": "^4.19.2",
    "express-graphql": "^0.12.0",
    "firebase-admin": "^12.2.0",
    "form-data": "^4.0.0",
    "graphql": "^16.9.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-tools": "^9.0.1",
    "graphql-ws": "^5.16.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "6.8",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "nexus": "^1.3.0",
    "unsplash-js": "^7.0.19",
    "verify-apple-id-token": "^3.1.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.11",
    "c8": "^10.1.3",
    "nodemon": "^3.1.4",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
